{
    "crons": [
        {
            "path": "/api/cron-backup",
            "schedule": "30 22 * * *"
        },
        {
            "path": "/api/cron-notify",
            "schedule": "0 23 * * *"
        },
        {
            "path": "/api/cron-watch",
            "schedule": "5 23 * * *"
        },
        {
            "path": "/api/cron-generate",
            "schedule": "30 21 * * *"
        },
        {
            "path": "/api/cron-household",
            "schedule": "0 0 1 * *"
        }
    ],
    "headers": [
        {
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ],
            "source": "/sw.js"
        },
        {
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ],
            "source": "/js/version.js"
        },
        {
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000"
                }
            ],
            "source": "/icon.png"
        },
        {
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, must-revalidate"
                }
            ],
            "source": "/manifest.json"
        }
    ],
    "outputDirectory": "public"
}
